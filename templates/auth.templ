package templates

// Login page template
templ Login() {
	@AuthLayout("SplitWeb - Login") {
		<div class="min-h-screen flex items-center justify-center py-6 px-4 sm:py-12 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-6 sm:space-y-8">
				<!-- Header -->
				<div class="text-center">
					<h1 class="text-3xl sm:text-4xl font-bold text-ctp-blue mb-2">SplitWeb</h1>
					<h2 class="text-lg sm:text-xl font-semibold text-ctp-text">Sign in to your account</h2>
					<p class="mt-2 text-sm text-ctp-subtext0">
						Or
						<a href="/register" class="font-medium text-ctp-blue hover:text-ctp-blue/80 transition-colors">
							create a new account
						</a>
					</p>
				</div>

				<!-- Login Form -->
				<div class="bg-ctp-mantle rounded-lg shadow-lg p-6 sm:p-8">
					<form
						hx-post="/auth/login"
						hx-target="#auth-feedback"
						class="space-y-6"
						x-data="{
							email: '',
							password: '',
							errors: {},
							validateForm() {
								this.errors = {};

								const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
								if (!this.email || !emailRegex.test(this.email)) {
									this.errors.email = 'Please enter a valid email address';
								}

								if (!this.password || this.password.length < 1) {
									this.errors.password = 'Password is required';
								}

								return Object.keys(this.errors).length === 0;
							},
							submitForm(event) {
								if (!this.validateForm()) {
									event.preventDefault();
									return false;
								}
							}
						}"
						@submit="submitForm($event)"
					>
						<div id="auth-feedback"></div>

						<div>
							<label for="email" class="block text-sm font-medium text-ctp-subtext1 mb-2">
								Email address
							</label>
							<input
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								required
								x-model="email"
								@input="validateForm()" @blur="validateForm()"
								class="w-full px-3 py-2 border rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 transition-colors"
								:class="errors.email ? 'border-ctp-red focus:ring-ctp-red focus:border-ctp-red' : 'border-ctp-surface2 focus:ring-ctp-blue focus:border-ctp-blue'"
								placeholder="Enter your email"
							/>
							<p x-show="errors.email" x-text="errors.email" class="mt-1 text-sm text-ctp-red"></p>
						</div>

						<div>
							<label for="password" class="block text-sm font-medium text-ctp-subtext1 mb-2">
								Password
							</label>
							<input
								id="password"
								name="password"
								type="password"
								autocomplete="current-password"
								required
								x-model="password"
								@input="validateForm()" @blur="validateForm()"
								class="w-full px-3 py-2 border rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 transition-colors"
								:class="errors.password ? 'border-ctp-red focus:ring-ctp-red focus:border-ctp-red' : 'border-ctp-surface2 focus:ring-ctp-blue focus:border-ctp-blue'"
								placeholder="Enter your password"
							/>
							<p x-show="errors.password" x-text="errors.password" class="mt-1 text-sm text-ctp-red"></p>
						</div>

						<div class="flex flex-col space-y-3 sm:flex-row sm:items-center sm:justify-between sm:space-y-0">
							<div class="flex items-center">
								<input
									id="remember-me"
									name="remember-me"
									type="checkbox"
									class="h-4 w-4 text-ctp-blue focus:ring-ctp-blue border-ctp-surface2 rounded"
								/>
								<label for="remember-me" class="ml-2 block text-sm text-ctp-subtext1">
									Remember me
								</label>
							</div>

							<div class="text-sm">
								<a href="/forgot-password" class="font-medium text-ctp-blue hover:text-ctp-blue/80 transition-colors">
									Forgot your password?
								</a>
							</div>
						</div>

						<div>
							<button
								type="submit"
								:disabled="Object.keys(errors).length > 0 || !email || !password"
								class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed"
								:class="Object.keys(errors).length > 0 || !email || !password ? 'text-ctp-subtext0 bg-ctp-surface2' : 'text-ctp-base bg-ctp-blue hover:bg-ctp-blue/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ctp-blue'"
							>
								<svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
								</svg>
								Sign in
							</button>
						</div>
					</form>
				</div>


			</div>
		</div>
	}
}

// Register page template
templ Register() {
	@AuthLayout("SplitWeb - Register") {
		<div class="min-h-screen flex items-center justify-center py-6 px-4 sm:py-12 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-6 sm:space-y-8">
				<!-- Header -->
				<div class="text-center">
					<h1 class="text-3xl sm:text-4xl font-bold text-ctp-blue mb-2">SplitWeb</h1>
					<h2 class="text-lg sm:text-xl font-semibold text-ctp-text">Create your account</h2>
					<p class="mt-2 text-sm text-ctp-subtext0">
						Already have an account?
						<a href="/login" class="font-medium text-ctp-blue hover:text-ctp-blue/80 transition-colors">
							Sign in
						</a>
					</p>
				</div>

				<!-- Register Form -->
				<div class="bg-ctp-mantle rounded-lg shadow-lg p-6 sm:p-8">
					<form
						hx-post="/auth/register"
						hx-target="#auth-feedback"
						class="space-y-6"
						x-data="{
							name: '',
							email: '',
							password: '',
							confirmPassword: '',
							errors: {},
							validateForm() {
								this.errors = {};

								if (!this.name || this.name.trim().length < 2) {
									this.errors.name = 'Full name must be at least 2 characters long';
								}

								const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
								if (!this.email || !emailRegex.test(this.email)) {
									this.errors.email = 'Please enter a valid email address';
								}

								if (!this.password || this.password.length < 6) {
									this.errors.password = 'Password must be at least 6 characters long';
								}

								if (this.password !== this.confirmPassword) {
									this.errors.confirmPassword = 'Passwords do not match';
								}

								return Object.keys(this.errors).length === 0;
							},
							submitForm(event) {
								if (!this.validateForm()) {
									event.preventDefault();
									return false;
								}
							}
						}"
						@submit="submitForm($event)"
					>
						<div id="auth-feedback"></div>

						<div>
							<label for="name" class="block text-sm font-medium text-ctp-subtext1 mb-2">
								Full name
							</label>
							<input
								id="name"
								name="name"
								type="text"
								autocomplete="name"
								required
								x-model="name"
								@input="validateForm()" @blur="validateForm()"
								class="w-full px-3 py-2 border rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 transition-colors"
								:class="errors.name ? 'border-ctp-red focus:ring-ctp-red focus:border-ctp-red' : 'border-ctp-surface2 focus:ring-ctp-blue focus:border-ctp-blue'"
								placeholder="Enter your full name"
							/>
							<p x-show="errors.name" x-text="errors.name" class="mt-1 text-sm text-ctp-red"></p>
						</div>

						<div>
							<label for="email" class="block text-sm font-medium text-ctp-subtext1 mb-2">
								Email address
							</label>
							<input
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								required
								x-model="email"
								@input="validateForm()" @blur="validateForm()"
								class="w-full px-3 py-2 border rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 transition-colors"
								:class="errors.email ? 'border-ctp-red focus:ring-ctp-red focus:border-ctp-red' : 'border-ctp-surface2 focus:ring-ctp-blue focus:border-ctp-blue'"
								placeholder="Enter your email"
							/>
							<p x-show="errors.email" x-text="errors.email" class="mt-1 text-sm text-ctp-red"></p>
						</div>

						<div>
							<label for="password" class="block text-sm font-medium text-ctp-subtext1 mb-2">
								Password
							</label>
							<input
								id="password"
								name="password"
								type="password"
								autocomplete="new-password"
								required
								x-model="password"
								@input="validateForm()"
								class="w-full px-3 py-2 border rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 transition-colors"
								:class="errors.password ? 'border-ctp-red focus:ring-ctp-red focus:border-ctp-red' : 'border-ctp-surface2 focus:ring-ctp-blue focus:border-ctp-blue'"
								placeholder="Create a password (min. 6 characters)"
							/>
							<p x-show="errors.password" x-text="errors.password" class="mt-1 text-sm text-ctp-red"></p>
						</div>

						<div>
							<label for="confirm-password" class="block text-sm font-medium text-ctp-subtext1 mb-2">
								Confirm password
							</label>
							<input
								id="confirm-password"
								name="confirm-password"
								type="password"
								autocomplete="new-password"
								required
								x-model="confirmPassword"
								@input="validateForm()"
								class="w-full px-3 py-2 border rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 transition-colors"
								:class="errors.confirmPassword ? 'border-ctp-red focus:ring-ctp-red focus:border-ctp-red' : 'border-ctp-surface2 focus:ring-ctp-blue focus:border-ctp-blue'"
								placeholder="Confirm your password"
							/>
							<p x-show="errors.confirmPassword" x-text="errors.confirmPassword" class="mt-1 text-sm text-ctp-red"></p>
						</div>

						<div>
							<button
								type="submit"
								:disabled="Object.keys(errors).length > 0 || !name || !email || !password || !confirmPassword"
								class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed"
								:class="Object.keys(errors).length > 0 || !name || !email || !password || !confirmPassword ? 'text-ctp-subtext0 bg-ctp-surface2' : 'text-ctp-base bg-ctp-blue hover:bg-ctp-blue/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ctp-blue'"
							>
								<svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
								</svg>
								Create account
							</button>
						</div>
					</form>
				</div>


			</div>
		</div>
	}
}

// Forgot Password page template
templ ForgotPassword() {
	@AuthLayout("SplitWeb - Forgot Password") {
		<div class="min-h-screen flex items-center justify-center py-6 px-4 sm:py-12 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-6 sm:space-y-8">
				<!-- Header -->
				<div class="text-center">
					<h1 class="text-3xl sm:text-4xl font-bold text-ctp-blue mb-2">SplitWeb</h1>
					<h2 class="text-lg sm:text-xl font-semibold text-ctp-text">Reset your password</h2>
					<p class="mt-2 text-sm text-ctp-subtext0">
						Remember your password?
						<a href="/login" class="font-medium text-ctp-blue hover:text-ctp-blue/80 transition-colors">
							Sign in
						</a>
					</p>
				</div>

				<!-- Forgot Password Form -->
				<div class="bg-ctp-mantle rounded-lg shadow-lg p-6 sm:p-8">
					<form
						hx-post="/auth/forgot-password"
						hx-target="#auth-feedback"
						class="space-y-6"
						x-data="{
							email: '',
							errors: {},
							validateForm() {
								this.errors = {};

								const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
								if (!this.email || !emailRegex.test(this.email)) {
									this.errors.email = 'Please enter a valid email address';
								}

								return Object.keys(this.errors).length === 0;
							},
							submitForm(event) {
								if (!this.validateForm()) {
									event.preventDefault();
									return false;
								}
							}
						}"
						@submit="submitForm($event)"
					>
						<div id="auth-feedback"></div>

						<div class="bg-ctp-blue/10 border border-ctp-blue/30 rounded-lg p-4">
							<div class="flex">
								<svg class="h-5 w-5 text-ctp-blue mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<div>
									<p class="text-sm text-ctp-blue">
										Enter your email address and we'll send you a link to reset your password.
									</p>
								</div>
							</div>
						</div>

						<div>
							<label for="email" class="block text-sm font-medium text-ctp-subtext1 mb-2">
								Email address
							</label>
							<input
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								required
								x-model="email"
								@input="validateForm()" @blur="validateForm()"
								class="w-full px-3 py-2 border rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 transition-colors"
								:class="errors.email ? 'border-ctp-red focus:ring-ctp-red focus:border-ctp-red' : 'border-ctp-surface2 focus:ring-ctp-blue focus:border-ctp-blue'"
								placeholder="Enter your email"
							/>
							<p x-show="errors.email" x-text="errors.email" class="mt-1 text-sm text-ctp-red"></p>
						</div>

						<div>
							<button
								type="submit"
								:disabled="Object.keys(errors).length > 0 || !email"
								class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed"
								:class="Object.keys(errors).length > 0 || !email ? 'text-ctp-subtext0 bg-ctp-surface2' : 'text-ctp-base bg-ctp-blue hover:bg-ctp-blue/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ctp-blue'"
							>
								<svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
								</svg>
								Send reset link
							</button>
						</div>

						<div class="text-center">
							<a href="/register" class="text-sm text-ctp-blue hover:text-ctp-blue/80 transition-colors">
								Don't have an account? Sign up
							</a>
						</div>
					</form>
				</div>


			</div>
		</div>
	}
}

// Success message template for password reset
templ PasswordResetSent(email string) {
	@AuthLayout("SplitWeb - Password Reset Sent") {
		<div class="min-h-screen flex items-center justify-center py-6 px-4 sm:py-12 sm:px-6 lg:px-8">
			<div class="max-w-md w-full space-y-6 sm:space-y-8">
				<!-- Header -->
				<div class="text-center">
					<h1 class="text-3xl sm:text-4xl font-bold text-ctp-blue mb-2">SplitWeb</h1>
					<h2 class="text-lg sm:text-xl font-semibold text-ctp-text">Check your email</h2>
				</div>

				<!-- Success Message -->
				<div class="bg-ctp-mantle rounded-lg shadow-lg p-6 sm:p-8">
					<div class="text-center">
						<div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-ctp-green/20 mb-6">
							<svg class="h-8 w-8 text-ctp-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
							</svg>
						</div>

						<p class="text-ctp-subtext0 mb-6">
							We've sent a password reset link to <strong class="text-ctp-text">{ email }</strong>.
							Click the link in the email to reset your password.
						</p>

						<div class="space-y-4">
							<button
								hx-post="/auth/resend-reset"
								hx-vals='{"email": "{ email }"}'
								hx-target="#auth-feedback"
								class="w-full flex justify-center py-2 px-4 border border-ctp-surface2 rounded-lg text-sm font-medium text-ctp-subtext1 bg-white dark:bg-gray-800 hover:bg-ctp-surface2 transition-colors"
							>
								Resend email
							</button>

							<a
								href="/login"
								class="block w-full text-center py-2 px-4 text-sm font-medium text-ctp-blue hover:text-ctp-blue/80 transition-colors"
							>
								Back to login
							</a>
						</div>

						<div id="auth-feedback" class="mt-4"></div>
					</div>
				</div>


			</div>
		</div>
	}
}
