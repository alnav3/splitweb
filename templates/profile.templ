package templates

import (
	"fmt"
	"net/url"
	"time"
	"github.com/alnav3/splitweb/db/internal_repository"
)

// Profile page header component
templ ProfileHeader() {
	<header class="bg-ctp-mantle shadow">
		<div class="max-w-4xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex items-center">
			<a href="/" class="mr-3 sm:mr-4 text-ctp-subtext0 hover:text-ctp-blue">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
				</svg>
			</a>
			<div class="flex-1 min-w-0">
				<h1 class="text-lg sm:text-2xl font-bold truncate">Profile Settings</h1>
				<p class="text-xs sm:text-sm text-ctp-subtext0 truncate">Manage your account settings and preferences</p>
			</div>
		</div>
	</header>
}

// User info display card
templ UserInfoCard(user internalRepository.User, group_count int) {
	<div class="bg-ctp-mantle rounded-lg shadow mb-6">
		<div class="p-4 sm:p-6">
			<div class="flex flex-col sm:flex-row sm:items-center sm:space-x-6">
				<!-- Avatar -->
				<div class="flex justify-center sm:justify-start mb-4 sm:mb-0">
					<div class="relative">
						<img class="h-20 w-20 sm:h-24 sm:w-24 rounded-full ring-4 ring-ctp-blue/20" src={ func() string { 
							if user.AvatarUrl != nil && *user.AvatarUrl != "" { 
								return *user.AvatarUrl 
							} else { 
								userName := "User"
								if user.Name != nil && *user.Name != "" {
									userName = *user.Name
								}
								return "https://ui-avatars.com/api/?name=" + url.QueryEscape(userName) + "&background=89b4fa&color=fff"
							} 
						}() } alt={ func() string { if user.Name != nil { return *user.Name } else { return "User" } }() }/>
						<button class="absolute bottom-0 right-0 h-6 w-6 sm:h-8 sm:w-8 bg-ctp-blue rounded-full flex items-center justify-center text-white hover:bg-ctp-blue/90 transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
							</svg>
						</button>
					</div>
				</div>

				<!-- User details -->
				<div class="flex-1 text-center sm:text-left">
					<h2 class="text-xl sm:text-2xl font-bold text-ctp-text mb-2">{ func() string { if user.Name != nil { return *user.Name } else { return "User" } }() }</h2>
					<p class="text-sm sm:text-base text-ctp-subtext0 mb-3">{ user.Email }</p>

					<div class="grid grid-cols-2 gap-4 text-sm">
						<div class="text-center sm:text-left">
							<p class="text-ctp-subtext1 font-medium">Joined</p>
							<p class="text-ctp-text">{ user.CreatedAt.Format("Jan 2, 2006") }</p>
						</div>
						<div class="text-center sm:text-left">
							<p class="text-ctp-subtext1 font-medium">Groups</p>
							<p class="text-ctp-text">{ fmt.Sprintf("%d", group_count) }</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// Profile success/error alert component - matches dashboard style
templ ProfileAlert() {
	<div
		x-show="profileAlert"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 transform translate-y-2"
		x-transition:enter-end="opacity-100 transform translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 transform translate-y-0"
		x-transition:leave-end="opacity-0 transform translate-y-2"
		:class="profileAlertType === 'email' ? 'fixed top-4 right-4 z-50 bg-ctp-blue text-white px-6 py-4 rounded-lg shadow-lg max-w-sm' : profileAlertType === 'password' ? 'fixed top-4 right-4 z-50 bg-ctp-peach text-white px-6 py-4 rounded-lg shadow-lg max-w-sm' : profileAlertType === 'success' ? 'fixed top-4 right-4 z-50 bg-ctp-green text-white px-6 py-4 rounded-lg shadow-lg max-w-sm' : 'fixed top-4 right-4 z-50 bg-ctp-red text-white px-6 py-4 rounded-lg shadow-lg max-w-sm'"
	>
		<div class="flex items-center">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="profileAlertType === 'email' ? 'M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' : profileAlertType === 'password' ? 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' : profileAlertType === 'success' ? 'M5 13l4 4L19 7' : 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'"/>
			</svg>
			<p class="font-medium" x-text="profileAlertMessage"></p>
		</div>
	</div>
}

// Change email form component (collapsible)
templ ChangeEmailForm() {
	<div>
		<div>
			<!-- Header Button -->
			<button
				@click="showEmailForm = !showEmailForm"
				class="w-full flex items-center justify-between p-3 bg-ctp-surface1/50 rounded-lg hover:bg-ctp-surface1/80 transition-colors duration-200"
			>
				<div class="flex items-center">
					<div class="bg-ctp-blue/10 p-2 rounded-lg mr-3">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-ctp-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
					</div>
					<div class="text-left">
						<h3 class="text-base sm:text-lg font-semibold text-ctp-text">Change Email Address</h3>
						<p class="text-xs sm:text-sm text-ctp-subtext0">Update your email address</p>
					</div>
				</div>
				<div class="flex items-center">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-5 w-5 text-ctp-subtext0 transform transition-transform duration-200"
						:class="showEmailForm ? 'rotate-180' : ''"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</div>
			</button>

			<!-- Collapsible Form -->
			<div
				x-show="showEmailForm"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 transform -translate-y-2"
				x-transition:enter-end="opacity-100 transform translate-y-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 transform translate-y-0"
				x-transition:leave-end="opacity-0 transform -translate-y-2"
				class="mt-4"
			>
				<form
					hx-post="/profile/email"
					hx-target="#email-feedback"
					hx-swap="innerHTML"
					class="space-y-4 sm:space-y-5"
					@submit="
						setTimeout(() => {
							showEmailForm = false;
							profileAlertMessage = 'Email updated successfully! Check your inbox for verification.';
							profileAlertType = 'email';
							profileAlert = true;
							setTimeout(() => profileAlert = false, 4000);
						}, 1000);
					"
				>
					<div id="email-feedback" class="hidden"></div>

					<div>
						<label for="new-email" class="block text-sm font-semibold text-ctp-subtext1 mb-2">New Email Address</label>
						<input
							type="email"
							id="new-email"
							name="new-email"
							required
							class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-blue focus:border-ctp-blue transition-colors text-sm sm:text-base"
							placeholder="Enter your new email address"
						/>
					</div>

					<div>
						<label for="email-password" class="block text-sm font-semibold text-ctp-subtext1 mb-2">Current Password</label>
						<input
							type="password"
							id="email-password"
							name="current-password"
							required
							class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-blue focus:border-ctp-blue transition-colors text-sm sm:text-base"
							placeholder="Confirm with your current password"
						/>
					</div>

					<div class="bg-ctp-blue/10 rounded-lg p-3 sm:p-4 border border-ctp-blue/20">
						<div class="flex items-start">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-ctp-blue mr-2 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<p class="text-xs sm:text-sm text-ctp-blue">A verification email will be sent to your new address before the change takes effect.</p>
						</div>
					</div>

					<div class="flex flex-col sm:flex-row gap-3 pt-2">
						<button
							type="submit"
							class="flex-1 bg-ctp-blue hover:bg-ctp-blue/90 text-white font-semibold py-2 sm:py-3 px-4 sm:px-6 rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center text-sm sm:text-base"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
							Update Email
						</button>
						<button
							type="button"
							@click="showEmailForm = false"
							class="px-4 sm:px-6 py-2 sm:py-3 border-2 border-ctp-surface2 rounded-lg text-ctp-subtext1 hover:bg-ctp-surface1/50 font-semibold transition-all duration-200 text-sm sm:text-base"
						>
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

// Change password form component (collapsible)
templ ChangePasswordForm() {
	<div>
		<div>
			<!-- Header Button -->
			<button
				@click="showPasswordForm = !showPasswordForm"
				class="w-full flex items-center justify-between p-3 bg-ctp-surface1/50 rounded-lg hover:bg-ctp-surface1/80 transition-colors duration-200"
			>
				<div class="flex items-center">
					<div class="bg-ctp-peach/10 p-2 rounded-lg mr-3">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-ctp-peach" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
						</svg>
					</div>
					<div class="text-left">
						<h3 class="text-base sm:text-lg font-semibold text-ctp-text">Change Password</h3>
						<p class="text-xs sm:text-sm text-ctp-subtext0">Update your account password</p>
					</div>
				</div>
				<div class="flex items-center">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-5 w-5 text-ctp-subtext0 transform transition-transform duration-200"
						:class="showPasswordForm ? 'rotate-180' : ''"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</div>
			</button>

			<!-- Collapsible Form -->
			<div
				x-show="showPasswordForm"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 transform -translate-y-2"
				x-transition:enter-end="opacity-100 transform translate-y-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 transform translate-y-0"
				x-transition:leave-end="opacity-0 transform -translate-y-2"
				class="mt-4"
			>
				<form
					hx-post="/profile/password"
					hx-target="#password-feedback"
					hx-swap="innerHTML"
					class="space-y-4 sm:space-y-5"
					@submit="
						setTimeout(() => {
							showPasswordForm = false;
							profileAlertMessage = 'Password updated successfully!';
							profileAlertType = 'password';
							profileAlert = true;
							setTimeout(() => profileAlert = false, 4000);
						}, 1000);
					"
				>
					<div id="password-feedback" class="hidden"></div>

					<div>
						<label for="current-password" class="block text-sm font-semibold text-ctp-subtext1 mb-2">Current Password</label>
						<input
							type="password"
							id="current-password"
							name="current-password"
							required
							class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-peach focus:border-ctp-peach transition-colors text-sm sm:text-base"
							placeholder="Enter your current password"
						/>
					</div>

					<div>
						<label for="new-password" class="block text-sm font-semibold text-ctp-subtext1 mb-2">New Password</label>
						<input
							type="password"
							id="new-password"
							name="new-password"
							required
							minlength="8"
							class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-peach focus:border-ctp-peach transition-colors text-sm sm:text-base"
							placeholder="Create a new password (min. 8 characters)"
						/>
					</div>

					<div>
						<label for="confirm-new-password" class="block text-sm font-semibold text-ctp-subtext1 mb-2">Confirm New Password</label>
						<input
							type="password"
							id="confirm-new-password"
							name="confirm-new-password"
							required
							minlength="8"
							class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-peach focus:border-ctp-peach transition-colors text-sm sm:text-base"
							placeholder="Confirm your new password"
						/>
					</div>

					<div class="bg-ctp-peach/10 rounded-lg p-3 sm:p-4 border border-ctp-peach/20">
						<div class="flex items-start">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-ctp-peach mr-2 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<div class="text-xs sm:text-sm text-ctp-peach">
								<p class="font-medium mb-1">Password requirements:</p>
								<ul class="list-disc list-inside space-y-1">
									<li>At least 8 characters long</li>
									<li>Include uppercase and lowercase letters</li>
									<li>Include at least one number</li>
								</ul>
							</div>
						</div>
					</div>

					<div class="flex flex-col sm:flex-row gap-3 pt-2">
						<button
							type="submit"
							class="flex-1 bg-ctp-peach hover:bg-ctp-peach/90 text-ctp-base font-semibold py-2 sm:py-3 px-4 sm:px-6 rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center text-sm sm:text-base"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
							Update Password
						</button>
						<button
							type="button"
							@click="showPasswordForm = false"
							class="px-4 sm:px-6 py-2 sm:py-3 border-2 border-ctp-surface2 rounded-lg text-ctp-subtext1 hover:bg-ctp-surface1/50 font-semibold transition-all duration-200 text-sm sm:text-base"
						>
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

// Account statistics component
templ AccountStats(user internalRepository.User, groupCount int) {
	<div class="bg-ctp-mantle rounded-lg shadow mb-6">
		<div class="p-4 sm:p-6">
			<h3 class="text-base sm:text-lg font-semibold text-ctp-text mb-4">Account Overview</h3>

			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<div class="bg-ctp-surface1/50 p-4 rounded-lg text-center">
					<div class="text-2xl sm:text-3xl font-bold text-ctp-blue mb-1">{ fmt.Sprintf("%d", groupCount) }</div>
					<div class="text-xs sm:text-sm text-ctp-subtext0">Active Groups</div>
				</div>

				<div class="bg-ctp-surface1/50 p-4 rounded-lg text-center">
					<div class="text-2xl sm:text-3xl font-bold text-ctp-green mb-1">${ fmt.Sprintf("%.2f", user.TotalExpenses) }</div>
					<div class="text-xs sm:text-sm text-ctp-subtext0">Total Expenses</div>
				</div>

				<div class="bg-ctp-surface1/50 p-4 rounded-lg text-center">
					<div class="text-2xl sm:text-3xl font-bold text-ctp-mauve mb-1">{ fmt.Sprintf("%.0f", time.Since(user.CreatedAt).Hours()/24) }</div>
					<div class="text-xs sm:text-sm text-ctp-subtext0">Days Active</div>
				</div>
			</div>
		</div>
	</div>
}

// Delete account modal (matches dashboard style)
templ DeleteAccountModal() {
	<div
		x-show="deleteModal"
		class="fixed inset-0 z-50 overflow-y-auto"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
	>
		<div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
			<div
				@click="deleteModal = false"
				class="fixed inset-0 bg-black/30 transition-opacity"
			></div>

			<div
				class="relative bg-ctp-mantle rounded-lg shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
			>
				<div class="px-6 pt-6 pb-4">
					<div class="flex items-center mb-4">
						<div class="bg-ctp-red/10 p-3 rounded-full mr-4">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ctp-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.728-.833-2.498 0L4.316 16.5c-.77.833.192 2.5 1.732 2.5z"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-ctp-text">Delete Account</h3>
							<p class="text-sm text-ctp-subtext0">This action cannot be undone</p>
						</div>
					</div>

					<div class="mb-6">
						<p class="text-sm text-ctp-text mb-3">
							Are you absolutely sure you want to delete your account?
						</p>
						<div class="bg-ctp-red/10 rounded-lg p-3 border border-ctp-red/20">
							<p class="text-sm text-ctp-red font-medium mb-2">This will permanently:</p>
							<ul class="text-xs text-ctp-red space-y-1 ml-4">
								<li>• Delete your profile and all personal data</li>
								<li>• Remove you from all groups</li>
								<li>• Delete all your expense records</li>
								<li>• Cancel any pending invitations</li>
							</ul>
						</div>
					</div>

					<div class="flex flex-col sm:flex-row gap-3">
						<button
							@click="
								deleteModal = false;
								profileAlertMessage = 'Account deleted successfully';
								profileAlertType = 'error';
								profileAlert = true;
								setTimeout(() => profileAlert = false, 4000);
							"
							hx-delete="/profile/delete"
							class="flex-1 bg-ctp-red hover:bg-ctp-red/90 text-white font-semibold py-2 px-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
							</svg>
							Yes, Delete Account
						</button>
						<button
							@click="deleteModal = false"
							class="px-4 py-2 border-2 border-ctp-surface2 rounded-lg text-ctp-subtext1 hover:bg-ctp-surface1 font-semibold transition-all duration-200"
						>
							Cancel
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// Delete account section (dangerous zone)
templ DeleteAccountSection() {
	<div class="bg-ctp-mantle rounded-lg shadow border border-ctp-red/20">
		<div class="p-4 sm:p-6">
			<div class="flex items-center mb-4">
				<div class="bg-ctp-red/10 p-2 rounded-lg mr-3">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-ctp-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.728-.833-2.498 0L4.316 16.5c-.77.833.192 2.5 1.732 2.5z" />
					</svg>
				</div>
				<h3 class="text-base sm:text-lg font-semibold text-ctp-red">Danger Zone</h3>
			</div>

			<div class="bg-ctp-red/5 rounded-lg p-4 border border-ctp-red/20 mb-4">
				<p class="text-sm text-ctp-text mb-2"><strong>Delete Account</strong></p>
				<p class="text-xs sm:text-sm text-ctp-subtext0">
					Once you delete your account, there is no going back. This will permanently delete your profile,
					remove you from all groups, and delete all your expense data.
				</p>
			</div>

			<div class="flex flex-col sm:flex-row gap-3">
				<button
					@click="deleteModal = true"
					class="bg-ctp-red hover:bg-ctp-red/90 text-white font-semibold py-2 px-4 rounded-lg text-sm transition-all duration-200 flex items-center justify-center"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
					</svg>
					Delete Account
				</button>
			</div>
		</div>
	</div>
}

// Main profile page template
templ ProfilePage(user internalRepository.User, group_count int) {
	@Layout("SplitWeb - Profile") {
		<div class="min-h-screen flex flex-col bg-ctp-base" x-data="{
			profileAlert: false,
			profileAlertMessage: '',
			profileAlertType: 'success',
			showEmailForm: false,
			showPasswordForm: false,
			deleteModal: false
		}">

			<!-- Header -->
			@ProfileHeader()

		<!-- Main content -->
		<main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-8">
			<!-- User info card -->
			@UserInfoCard(user, group_count)

			<!-- Account statistics -->
			@AccountStats(user, group_count)

			<!-- Settings Section -->
			<div class="bg-ctp-mantle rounded-lg shadow mb-6">
				<div class="p-4 sm:p-6">
					<h3 class="text-lg sm:text-xl font-semibold text-ctp-text mb-6 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 mr-3 text-ctp-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
						Account Settings
					</h3>

					<div class="space-y-4">
						<!-- Change email form (embedded) -->
						<div class="border-b border-ctp-surface2 pb-4 last:border-b-0 last:pb-0">
							@ChangeEmailForm()
						</div>

						<!-- Change password form (embedded) -->
						<div class="border-b border-ctp-surface2 pb-4 last:border-b-0 last:pb-0">
							@ChangePasswordForm()
						</div>
					</div>
				</div>
			</div>

			<!-- Danger zone -->
			@DeleteAccountSection()
		</main>

		<!-- Profile alerts -->
		@ProfileAlert()

		<!-- Delete account modal -->
		@DeleteAccountModal()
		</div>
	}
}
