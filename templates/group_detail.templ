package templates

import (
	"fmt"
	"strconv"
)

// Member represents a user in a group
type Member struct {
	ID       string
	Name     string
	ImageURL string
}

// Charge represents an expense within a group
type Charge struct {
	ID           string
	Description  string
	Amount       float64
	PaidBy       Member
	Date         string
	Participants []Member
}

// Payment represents money sent from one user to another
type Payment struct {
	ID         string
	FromMember Member
	ToMember   Member
	Amount     float64
	Date       string
}

// Debt represents what one user owes to another
type Debt struct {
	FromMember Member
	ToMember   Member
	Amount     float64
}

// GroupDetail contains all the data needed for a group detail page
type GroupDetail struct {
	ID          string
	Name        string
	Description string
	ImageURL    string
	Members     []Member
	Charges     []Charge
	Payments    []Payment
	Debts       []Debt
}

// Format a float as a money string
func formatMoney(amount float64) string {
	return fmt.Sprintf("$%.2f", amount)
}

// Helper for determining positive/negative class
func getBalanceClass(amount float64) string {
	if amount > 0 {
		return "text-ctp-green"
	} else if amount < 0 {
		return "text-ctp-red"
	}
	return "text-ctp-subtext0"
}

// Calculate total amount owed to others
func calculateTotalOwed(debts []Debt) float64 {
	var total float64
	for _, debt := range debts {
		// Only count positive debts where the user owes money
		if debt.FromMember.ID == "me" && debt.Amount > 0 {
			total += debt.Amount
		}
	}
	return total
}

// Calculate total amount due from others
func calculateTotalDue(debts []Debt) float64 {
	var total float64
	for _, debt := range debts {
		// Only count negative debts where others owe the user
		if debt.FromMember.ID == "me" && debt.Amount < 0 {
			total += -debt.Amount // Make it positive
		}
	}
	return total
}

// Get default active tab
func getDefaultActiveTab(activeTab string) string {
	if activeTab == "" {
		return "charges"
	}
	return activeTab
}

// Header component for the group detail page
templ GroupHeader(group GroupDetail) {
	<header class="bg-ctp-mantle shadow">
		<div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex items-center">
			<a href="/" class="mr-3 sm:mr-4 text-ctp-subtext0 hover:text-ctp-blue">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
				</svg>
			</a>
			<div class="flex-1 min-w-0">
				<h1 class="text-lg sm:text-2xl font-bold truncate">{ group.Name }</h1>
				<p class="text-xs sm:text-sm text-ctp-subtext0 truncate">{ group.Description }</p>
			</div>
		</div>
	</header>
}

// Tab navigation component with HTMX
templ TabNavigation(activeTab string) {
	<div class="bg-ctp-mantle border-b border-ctp-surface2">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<nav class="flex -mb-px overflow-x-auto scrollbar-hide" x-data="{ activeTab: 'charges' }">
				<button
					hx-get="/group/tab/charges"
					hx-target="#tab-content"
					@click="activeTab = 'charges'"
					hx-trigger="click"
					class="py-3 sm:py-4 px-1 mr-4 sm:mr-8 border-b-2 font-medium text-xs sm:text-sm whitespace-nowrap flex-shrink-0"
					:class="activeTab === 'charges' ? 'border-ctp-blue text-ctp-blue' : 'border-transparent text-ctp-subtext0 hover:text-ctp-subtext1 hover:border-ctp-surface2'"
				>
					Charges
				</button>
				<button
					hx-get="/group/tab/balances"
					hx-target="#tab-content"
					@click="activeTab = 'balances'"
					hx-trigger="click"
					class="py-3 sm:py-4 px-1 mr-4 sm:mr-8 border-b-2 font-medium text-xs sm:text-sm whitespace-nowrap flex-shrink-0"
					:class="activeTab === 'balances' ? 'border-ctp-blue text-ctp-blue' : 'border-transparent text-ctp-subtext0 hover:text-ctp-subtext1 hover:border-ctp-surface2'"
				>
					Balances
				</button>
				<button
					hx-get="/group/tab/activity"
					hx-target="#tab-content"
					@click="activeTab = 'activity'"
					hx-trigger="click"
					class="py-3 sm:py-4 px-1 mr-4 sm:mr-8 border-b-2 font-medium text-xs sm:text-sm whitespace-nowrap flex-shrink-0"
					:class="activeTab === 'activity' ? 'border-ctp-blue text-ctp-blue' : 'border-transparent text-ctp-subtext0 hover:text-ctp-subtext1 hover:border-ctp-surface2'"
				>
					Activity
				</button>
				<button
					hx-get="/group/tab/breakdown"
					hx-target="#tab-content"
					@click="activeTab = 'breakdown'"
					hx-trigger="click"
					class="py-3 sm:py-4 px-1 border-b-2 font-medium text-xs sm:text-sm whitespace-nowrap flex-shrink-0"
					:class="activeTab === 'breakdown' ? 'border-ctp-blue text-ctp-blue' : 'border-transparent text-ctp-subtext0 hover:text-ctp-subtext1 hover:border-ctp-surface2'"
				>
					<span class="hidden sm:inline">Detailed</span> Breakdown
				</button>
			</nav>
		</div>
	</div>
}

// Summary cards for total amounts
templ TotalSummary(group GroupDetail) {
	<div class="bg-ctp-mantle rounded-lg shadow mb-6 sm:mb-8">
		<div class="p-4 sm:p-6">
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
				<div class="bg-ctp-green/20 p-4 sm:p-6 rounded-lg">
					<h3 class="text-base sm:text-lg font-medium text-ctp-green mb-2">You Owe</h3>
					<p class="text-2xl sm:text-3xl font-bold text-ctp-green" id="total-owed">{ formatMoney(calculateTotalOwed(group.Debts)) }</p>
				</div>
				<div class="bg-ctp-blue/20 p-4 sm:p-6 rounded-lg">
					<h3 class="text-base sm:text-lg font-medium text-ctp-blue mb-2">You're Owed</h3>
					<p class="text-2xl sm:text-3xl font-bold text-ctp-blue" id="total-due">{ formatMoney(calculateTotalDue(group.Debts)) }</p>
				</div>
			</div>
		</div>
	</div>
}

// New Charge Modal component with HTMX (similar to dashboard style)
templ NewChargeModal(members []Member) {
	<div
		x-show="newChargeModal"
		class="fixed inset-0 z-50 overflow-y-auto"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
	>
		<div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
			<div
				@click="newChargeModal = false"
				class="fixed inset-0 bg-black/30 transition-opacity"
			></div>

			<div
				class="relative bg-ctp-mantle rounded-lg shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
			>
				<div class="px-6 pt-6 pb-4">
					<div class="flex items-center mb-4">
						<div class="bg-ctp-blue/10 p-3 rounded-full mr-4">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ctp-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-ctp-text">Add New Expense</h3>
							<p class="text-sm text-ctp-subtext0">Split a new charge among group members</p>
						</div>
					</div>

					<form hx-post="/group/charges" hx-target="#charges-list" hx-swap="afterbegin" @submit="
						setTimeout(() => {
							newChargeModal = false;
							alertMessage = 'Expense added successfully!';
							successAlert = true;
							setTimeout(() => successAlert = false, 4000);
						}, 500);
					" class="space-y-4">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="sm:col-span-2">
								<label for="description" class="block text-sm font-medium text-ctp-subtext1 mb-2">What's this expense for?</label>
								<input
									type="text"
									id="description"
									name="description"
									required
									class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-blue focus:border-ctp-blue transition-colors"
									placeholder="Dinner, groceries, gas, etc."
								/>
							</div>

							<div>
								<label for="amount" class="block text-sm font-medium text-ctp-subtext1 mb-2">Amount</label>
								<div class="relative rounded-lg shadow-sm">
									<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
										<span class="text-ctp-subtext0 sm:text-sm">$</span>
									</div>
									<input
										type="number"
										step="0.01"
										min="0.01"
										id="amount"
										name="amount"
										required
										class="pl-7 block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-blue focus:border-ctp-blue transition-colors"
										placeholder="0.00"
									/>
								</div>
							</div>

							<div>
								<label for="paidBy" class="block text-sm font-medium text-ctp-subtext1 mb-2">Who paid?</label>
								<select
									id="paidBy"
									name="paidBy"
									required
									class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-blue focus:border-ctp-blue transition-colors"
								>
									<option value="">Choose who paid</option>
									for _, member := range members {
										<option value={ member.ID }>{ member.Name }</option>
									}
								</select>
							</div>

							<div class="sm:col-span-2">
								<label class="block text-sm font-medium text-ctp-subtext1 mb-3">Split between these people</label>
								<div class="bg-ctp-surface1/30 rounded-lg border border-ctp-surface2 p-4 max-h-48 overflow-y-auto">
									<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
										for _, member := range members {
											<label class="flex items-center p-2 rounded-lg hover:bg-ctp-surface1/50 cursor-pointer transition-colors duration-150">
												<input type="checkbox" name="participants" value={ member.ID } class="rounded border-ctp-surface2 text-ctp-blue focus:ring-ctp-blue focus:ring-2 focus:ring-opacity-20 h-4 w-4 flex-shrink-0"/>
												<div class="ml-3 flex items-center min-w-0">
													<img class="h-8 w-8 rounded-full mr-3 ring-2 ring-ctp-base flex-shrink-0" src={ member.ImageURL } alt={ member.Name }/>
													<span class="text-sm font-medium text-ctp-text truncate">{ member.Name }</span>
												</div>
											</label>
										}
									</div>
								</div>
							</div>
						</div>

						<div class="flex flex-col sm:flex-row gap-3 pt-4">
							<button
								type="submit"
								class="flex-1 bg-ctp-blue hover:bg-ctp-blue/90 text-white font-semibold py-2 px-4 rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
								</svg>
								Add Expense
							</button>
							<button
								type="button"
								@click="newChargeModal = false"
								class="px-4 py-2 border-2 border-ctp-surface2 rounded-lg text-ctp-subtext1 hover:bg-ctp-surface1 font-semibold transition-all duration-200"
							>
								Cancel
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}

// Single Charge Item component
templ ChargeItem(charge Charge) {
	<div class="flex justify-between items-start py-3 border-b border-ctp-surface2 last:border-0 charge-item">
		<div class="flex items-start min-w-0 flex-1">
			<img class="h-8 w-8 sm:h-10 sm:w-10 rounded-full mr-2 sm:mr-3 flex-shrink-0" src={ charge.PaidBy.ImageURL } alt={ charge.PaidBy.Name }/>
			<div class="min-w-0 flex-1">
				<h3 class="font-medium text-sm sm:text-base truncate">{ charge.Description }</h3>
				<p class="text-xs sm:text-sm text-ctp-subtext0">
					{ charge.PaidBy.Name } paid • { charge.Date }
				</p>
				<div class="flex -space-x-1 mt-1">
					for i, participant := range charge.Participants {
						if i < 3 {
							<img class="h-4 w-4 sm:h-5 sm:w-5 rounded-full ring-1 ring-ctp-base" src={ participant.ImageURL } alt={ participant.Name } title={ participant.Name }/>
						}
					}
					if len(charge.Participants) > 3 {
						<div class="h-4 w-4 sm:h-5 sm:w-5 rounded-full ring-1 ring-ctp-base bg-ctp-surface2 flex items-center justify-center text-xs">
							+{ strconv.Itoa(len(charge.Participants) - 3) }
						</div>
					}
				</div>
			</div>
		</div>
		<div class="text-right ml-2 flex-shrink-0">
			<div class="font-medium text-sm sm:text-base">{ formatMoney(charge.Amount) }</div>
			<div class="text-xs sm:text-sm text-ctp-subtext0">
				{ formatMoney(charge.Amount / float64(len(charge.Participants))) } per person
			</div>
		</div>
	</div>
}

// Charges Tab Content with Alpine.js (updated to use modal)
templ ChargesTabContent(group GroupDetail) {
	<div>
		<!-- Total Owed Summary -->
		@TotalSummary(group)

		<!-- Charges List -->
		<div class="bg-ctp-mantle rounded-lg shadow">
			<div class="p-4 sm:p-5">
				<div class="flex flex-col space-y-3 sm:flex-row sm:justify-between sm:items-center sm:space-y-0 mb-4 sm:mb-6">
					<h2 class="text-lg sm:text-xl font-bold text-ctp-text">Expenses</h2>
					<button
						@click="newChargeModal = true"
						class="bg-ctp-blue hover:bg-ctp-blue/90 text-white font-semibold py-2 px-4 rounded-lg text-sm shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
						</svg>
						Add Expense
					</button>
				</div>

				<!-- Charges List -->
				<div id="charges-list" class="space-y-4">
					if len(group.Charges) == 0 {
						<p class="text-center py-8 text-ctp-subtext0">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-ctp-surface2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
							</svg>
							No expenses yet. Add your first expense to get started!
						</p>
					}

					<!-- Existing charges from the backend -->
					for _, charge := range group.Charges {
						@ChargeItem(charge)
					}
				</div>
			</div>
		</div>
	</div>
}

// Settle Up Modal component with HTMX (similar to dashboard style)
templ SettleUpModal(members []Member) {
	<div
		x-show="settleModal"
		class="fixed inset-0 z-50 overflow-y-auto"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
	>
		<div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
			<div
				@click="settleModal = false"
				class="fixed inset-0 bg-black/30 transition-opacity"
			></div>

			<div
				class="relative bg-ctp-mantle rounded-lg shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
			>
				<div class="px-6 pt-6 pb-4">
					<div class="flex items-center mb-4">
						<div class="bg-ctp-green/10 p-3 rounded-full mr-4">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ctp-green" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-ctp-text">Settle Payment</h3>
							<p class="text-sm text-ctp-subtext0">Record a payment between group members</p>
						</div>
					</div>

					<form hx-post="/group/settlements" @submit="
						setTimeout(() => {
							settleModal = false;
							alertMessage = 'Payment recorded successfully!';
							successAlert = true;
							setTimeout(() => successAlert = false, 4000);
						}, 500);
					" class="space-y-4">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="sm:col-span-2">
								<label for="settle-with" class="block text-sm font-medium text-ctp-subtext1 mb-2">Who are you paying?</label>
								<select
									id="settle-with"
									name="settle-with"
									required
									class="block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-green focus:border-ctp-green transition-colors"
								>
									<option value="">Choose who you're paying</option>
									for _, member := range members {
										if member.ID != "me" {
											<option value={ member.ID }>{ member.Name }</option>
										}
									}
								</select>
							</div>

							<div class="sm:col-span-2">
								<label for="settle-amount" class="block text-sm font-medium text-ctp-subtext1 mb-2">Payment Amount</label>
								<div class="relative rounded-lg shadow-sm">
									<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
										<span class="text-ctp-subtext0 sm:text-sm">$</span>
									</div>
									<input
										type="number"
										step="0.01"
										min="0.01"
										id="settle-amount"
										name="settle-amount"
										required
										class="pl-7 block w-full px-3 py-2 border border-ctp-surface2 rounded-lg shadow-sm placeholder-ctp-subtext0 bg-ctp-surface1 text-ctp-text focus:outline-none focus:ring-2 focus:ring-ctp-green focus:border-ctp-green transition-colors"
										placeholder="0.00"
									/>
								</div>
							</div>
						</div>

						<div class="bg-ctp-green/10 rounded-lg p-4 border border-ctp-green/20">
							<div class="flex items-start">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ctp-green mr-2 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
								<p class="text-sm text-ctp-green font-medium">This will record a payment and update everyone's balances automatically.</p>
							</div>
						</div>

						<div class="flex flex-col sm:flex-row gap-3">
							<button
								type="submit"
								class="flex-1 bg-ctp-green hover:bg-ctp-green/90 text-white font-semibold py-2 px-4 rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
								</svg>
								Record Payment
							</button>
							<button
								type="button"
								@click="settleModal = false"
								class="px-4 py-2 border-2 border-ctp-surface2 rounded-lg text-ctp-subtext1 hover:bg-ctp-surface1 font-semibold transition-all duration-200"
							>
								Cancel
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}

// Balance Item component with Alpine.js (updated to use modal)
templ BalanceItem(member Member, debts []Debt) {
	<div class="flex justify-between items-center py-3 border-b border-ctp-surface2 last:border-0">
		<div class="flex items-center min-w-0 flex-1">
			<img class="h-8 w-8 sm:h-10 sm:w-10 rounded-full mr-2 sm:mr-3 flex-shrink-0" src={ member.ImageURL } alt={ member.Name }/>
			<span class="font-medium text-sm sm:text-base truncate">{ member.Name }</span>
		</div>
		<!-- Find the debt between current user and this member -->
		for _, debt := range debts {
			if debt.FromMember.ID == "me" && debt.ToMember.ID == member.ID {
				<div class={ "text-xs sm:text-sm font-medium text-center mx-2 " + getBalanceClass(debt.Amount) }>
					if debt.Amount > 0 {
						<div class="hidden sm:inline">you owe</div> { formatMoney(debt.Amount) }
					} else if debt.Amount < 0 {
						<div class="hidden sm:inline">owes you</div> { formatMoney(-debt.Amount) }
					} else {
						settled up
					}
				</div>
			}
		}
		<button
			@click="settleModal = true; $nextTick(() => document.querySelector('select[name=settle-with]').value = '{ member.ID }')"
			class="ml-2 bg-ctp-green/10 text-ctp-green hover:bg-ctp-green/20 font-medium text-xs sm:text-sm px-3 py-1 rounded-lg flex-shrink-0 transition-colors duration-200"
		>
			Pay
		</button>
	</div>
}

// Balances Tab Content with Alpine.js (updated to use modal)
templ BalancesTabContent(group GroupDetail) {
	<div>
		<div class="bg-ctp-mantle rounded-lg shadow">
			<div class="p-4 sm:p-5">
				<div class="flex flex-col space-y-3 sm:flex-row sm:justify-between sm:items-center sm:space-y-0 mb-4 sm:mb-6">
					<h2 class="text-lg sm:text-xl font-bold text-ctp-text">Your Balances</h2>
					<button
						@click="settleModal = true"
						class="bg-ctp-green hover:bg-ctp-green/90 text-white font-semibold py-2 px-4 rounded-lg text-sm shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z"/>
						</svg>
						Settle Payment
					</button>
				</div>

				<div id="balances-list" class="space-y-4">
					if len(group.Members) <= 1 {
						<p class="text-center py-8 text-ctp-subtext0">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-ctp-surface2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
							</svg>
							No other members to show balances with. Invite someone to get started!
						</p>
					}
					<!-- Individual balances with other members -->
					for _, member := range group.Members {
						if member.ID != "me" {
							@BalanceItem(member, group.Debts)
						}
					}
				</div>
			</div>
		</div>
	</div>
}

// Activity Item component for charges
templ ChargeActivityItem(charge Charge) {
	<div class="flex items-start py-3 border-b border-ctp-surface2 last:border-0 activity-item" data-type="charge" data-id={ charge.ID }>
		<div class="bg-green-100 dark:bg-green-900/30 p-2 rounded-full mr-4">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ctp-green dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
			</svg>
		</div>
		<div class="flex-1">
			<h3 class="font-medium">{ charge.Description }</h3>
			<p class="text-sm text-ctp-subtext0">
				{ charge.PaidBy.Name } added a new charge • { charge.Date }
			</p>
		</div>
		<div class="text-right font-medium">
			{ formatMoney(charge.Amount) }
		</div>
	</div>
}

// Activity Item component for payments
templ PaymentActivityItem(payment Payment) {
	<div class="flex items-start py-3 border-b border-ctp-surface2 last:border-0 activity-item" data-type="payment" data-id={ payment.ID }>
		<div class="bg-blue-100 dark:bg-blue-900/30 p-2 rounded-full mr-4">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z" />
			</svg>
		</div>
		<div class="flex-1">
			<h3 class="font-medium">Payment</h3>
			<p class="text-sm text-ctp-subtext0">
				{ payment.FromMember.Name } paid { payment.ToMember.Name } • { payment.Date }
			</p>
		</div>
		<div class="text-right font-medium">
			{ formatMoney(payment.Amount) }
		</div>
	</div>
}

// Activity Tab Content
templ ActivityTabContent(group GroupDetail) {
	<div class="bg-ctp-mantle rounded-lg shadow">
		<div class="p-4 sm:p-5">
			<h2 class="text-lg font-bold mb-4">Recent Activity</h2>

			<div id="activity-list" class="space-y-4">
				if len(group.Charges) == 0 && len(group.Payments) == 0 {
					<p class="text-center py-4 text-ctp-subtext0">No activity yet.</p>
				}

				<!-- Existing charges from the backend -->
				for _, charge := range group.Charges {
					@ChargeActivityItem(charge)
				}

				<!-- Existing payments from the backend -->
				for _, payment := range group.Payments {
					@PaymentActivityItem(payment)
				}
			</div>
		</div>
	</div>
}

// Detailed Breakdown Tab Content
templ BreakdownTabContent(group GroupDetail) {
	<div class="bg-ctp-mantle rounded-lg shadow">
		<div class="p-4 sm:p-5">
			<h2 class="text-lg font-bold mb-4">Detailed Breakdown</h2>

			<div class="overflow-x-auto -mx-4 sm:mx-0">
				<table class="min-w-full divide-y divide-ctp-surface2">
					<thead>
						<tr>
							<th class="px-2 sm:px-3 py-2 sm:py-3 bg-ctp-surface1 text-left text-xs font-medium text-ctp-subtext0 uppercase tracking-wider">Person</th>
							for _, member := range group.Members {
								<th class="px-2 sm:px-3 py-2 sm:py-3 bg-ctp-surface1 text-left text-xs font-medium text-ctp-subtext0 uppercase tracking-wider whitespace-nowrap">
									<span class="hidden sm:inline">{ member.Name }</span>
									<span class="sm:hidden">{ member.Name[:1] }</span>
								</th>
							}
						</tr>
					</thead>
					<tbody class="bg-ctp-mantle divide-y divide-ctp-surface2">
						for _, rowMember := range group.Members {
							<tr>
								<td class="px-2 sm:px-3 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm font-medium">
									<div class="flex items-center">
										<img class="h-5 w-5 sm:h-6 sm:w-6 rounded-full mr-1 sm:mr-2" src={ rowMember.ImageURL } alt={ rowMember.Name }/>
										<span class="hidden sm:inline">{ rowMember.Name }</span>
										<span class="sm:hidden">{ rowMember.Name[:1] }</span>
									</div>
								</td>
								for _, colMember := range group.Members {
									<td class="px-2 sm:px-3 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-center">
										if rowMember.ID == colMember.ID {
											<span class="text-gray-400">-</span>
										} else {
											<!-- Find the debt between these two people -->
											for _, debt := range group.Debts {
												if debt.FromMember.ID == rowMember.ID && debt.ToMember.ID == colMember.ID {
													<div class={ getBalanceClass(debt.Amount) }>
														if debt.Amount > 0 {
															{ formatMoney(debt.Amount) }
														} else if debt.Amount < 0 {
															{ formatMoney(-debt.Amount) }
														} else {
															$0.00
														}
													</div>
												}
											}
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>

			<div class="mt-4 text-sm text-ctp-subtext0">
				<p>Positive amounts (green) indicate money owed to the person in the column.</p>
				<p>Negative amounts (red) indicate money owed by the person in the column.</p>
			</div>
		</div>
	</div>
}

// Success/Error Alert component (floating notification like dashboard)
templ GroupSuccessAlert() {
	<div
		x-show="successAlert"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 transform translate-y-2"
		x-transition:enter-end="opacity-100 transform translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 transform translate-y-0"
		x-transition:leave-end="opacity-0 transform translate-y-2"
		:class="errorAlert ? 'fixed top-4 right-4 z-50 bg-ctp-red text-white px-6 py-4 rounded-lg shadow-lg max-w-sm' : 'fixed top-4 right-4 z-50 bg-ctp-green text-white px-6 py-4 rounded-lg shadow-lg max-w-sm'"
	>
		<div class="flex items-center">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="errorAlert ? 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.728-.833-2.498 0L4.316 16.5c-.77.833.192 2.5 1.732 2.5z' : 'M5 13l4 4L19 7'"/>
			</svg>
			<p class="font-medium" x-text="alertMessage"></p>
		</div>
	</div>
}

// Main template
templ GroupDetailPage(group GroupDetail) {
	@Layout("SplitWeb - " + group.Name) {
		<div class="min-h-screen flex flex-col" x-data="{
			newChargeModal: false,
			settleModal: false,
			successAlert: false,
			errorAlert: false,
			alertMessage: ''
		}">
			<!-- Header -->
			@GroupHeader(group)

			<!-- Tab Navigation -->
			@TabNavigation("charges")

			<!-- Main content -->
            <div class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="py-4 sm:py-8">
					<!-- Tab content container for HTMX -->
					<div id="tab-content">
						@ChargesTabContent(group)
					</div>
				</div>
			</div>

			<!-- Modals -->
			@NewChargeModal(group.Members)
			@SettleUpModal(group.Members)
			
			<!-- Success/Error Alerts -->
			@GroupSuccessAlert()
		</div>
	}
}
