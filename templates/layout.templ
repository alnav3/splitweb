package templates

templ Layout(title string) {
	@BaseLayout(title, "bg-ctp-base text-ctp-text min-h-screen") {
		{ children... }
	}
}

templ AuthLayout(title string) {
	@BaseLayout(title, "bg-gradient-to-br from-ctp-mantle to-ctp-base text-ctp-text min-h-screen") {
		{ children... }
	}
}

templ BaseLayout(title string, bodyClasses string) {
	<!DOCTYPE html>
	<html lang="en" class="mocha">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<title>{ title }</title>
			<link rel="stylesheet" href="/style/tailwind.css" />
			<script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js"></script>
		</head>
		<body class={ bodyClasses }>
			{ children... }
		</body>
	</html>
}
